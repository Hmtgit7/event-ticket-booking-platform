{
  "name": "grabmyticket",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prepare": "husky install",
    "commit": "cz",
    "lint": "pnpm --dir client lint",
    "typecheck": "pnpm --dir client exec tsc --noEmit",
    "build:client": "pnpm --dir client build",
    "lint:notification-service": "pnpm --dir services/notification-service exec eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "typecheck:notification-service": "pnpm --dir services/notification-service exec tsc --noEmit",
    "test:notification-service": "pnpm --dir services/notification-service test",
    "build:notification-service": "pnpm --dir services/notification-service build",
    "test:services": "powershell -ExecutionPolicy Bypass -File scripts/check-services.ps1 test",
    "build:services": "powershell -ExecutionPolicy Bypass -File scripts/check-services.ps1 package",
    "check": "pnpm lint && pnpm typecheck && pnpm lint:notification-service && pnpm typecheck:notification-service && pnpm test:notification-service && pnpm build:client && pnpm build:notification-service && pnpm build:services"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}