# No API gateway in this architecture - the app calls each backend service
# directly, same as client/lib/env.ts. Expo only inlines env vars prefixed
# with EXPO_PUBLIC_ into the JS bundle (see lib/env.ts).
#
# Use your machine's LAN IP instead of localhost when testing on a physical
# device or in Expo Go - the phone can't resolve your laptop's "localhost".
# Android emulator: use 10.0.2.2 in place of localhost.
EXPO_PUBLIC_AUTH_API_URL=http://localhost:8081
EXPO_PUBLIC_EVENT_API_URL=http://localhost:8082
EXPO_PUBLIC_BOOKING_API_URL=http://localhost:8083
EXPO_PUBLIC_PAYMENT_API_URL=http://localhost:8084
EXPO_PUBLIC_NOTIFICATION_API_URL=http://localhost:3003
