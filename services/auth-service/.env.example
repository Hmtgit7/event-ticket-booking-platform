# Copy this file to .env.local for local development, or paste the Render block
# into Render's Environment Variables using "Add from .env".
# auth-service reads these via ${VAR:default} in application.yaml/application-prod.yaml.
# Never commit real secrets.

# --- Local development ---
SERVER_PORT=8081
DATABASE_URL=jdbc:postgresql://localhost:15432/grabmyticket
DATABASE_USERNAME=grabmyticket
DATABASE_PASSWORD=grabmyticket
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional extra frontend origin(s), comma-separated (e.g. custom domain alongside Vercel).
CORS_ADDITIONAL_ORIGINS=
FRONTEND_BASE_URL=http://localhost:3000

# --- Render production example ---
# Render sets PORT automatically for Web Services. Keep this commented locally.
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_JDBC_URL=jdbc:postgresql://<neon-host>/<neon-database>?sslmode=require
# DATABASE_USERNAME=<neon-username>
# DATABASE_PASSWORD=<neon-password>
# CORS_ALLOWED_ORIGINS=https://grabmyticket.vercel.app
# CORS_ADDITIONAL_ORIGINS=https://grabmyticket.me,https://www.grabmyticket.me
# FRONTEND_BASE_URL=https://grabmyticket.me

# --- JWT ---
# Must be identical across auth-service, event-service, and booking-service.
# Use a long random value in production, for example 64+ characters.
JWT_SECRET=change-me-local-development-secret-change-me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- Google Sign-In ---
# Same OAuth Client ID used by NextAuth on the client. GOOGLE_CLIENT_SECRET is
# only needed by the Next.js app, not by this backend service.
GOOGLE_CLIENT_ID=

# --- reCAPTCHA (leave blank until wired up) ---
RECAPTCHA_SECRET=

# --- Email verification ---
VERIFICATION_TOKEN_TTL=24h
VERIFICATION_RESEND_COOLDOWN=60s

# --- Brevo (transactional email) ---
# Get the API key from Brevo dashboard -> Settings -> SMTP & API -> API Keys.
# SMTP_FROM must be a sender verified in your Brevo account (Senders & IP).
# Leave both blank locally to fall back to console-logged email links instead
# of real delivery - see EmailConfig.
BREVO_API_KEY=
SMTP_FROM=
BREVO_SENDER_NAME=GrabMyTicket

# --- Admin bootstrap ---
# Leave blank in normal deployments. Only set temporarily if you need to grant
# ROLE_ADMIN through POST /auth/admin/bootstrap, then unset it and redeploy.
ADMIN_BOOTSTRAP_SECRET=
