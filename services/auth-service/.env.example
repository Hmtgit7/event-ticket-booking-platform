# Copy this file to .env.local (or export these into your shell / IDE run config).
# auth-service reads these via ${VAR:default} in application.yaml and application-local.yaml.
# Never commit the real .env file - it's already gitignored.

# --- Server ---
SERVER_PORT=8081

# --- Database (local Docker Compose Postgres by default) ---
DATABASE_URL=jdbc:postgresql://localhost:15432/grabmyticket
DATABASE_USERNAME=grabmyticket
DATABASE_PASSWORD=grabmyticket


# DB_URL=postgresql://neondb_owner:npg_NQa8U6GOmlKD@ep-wispy-water-ax4e9p4m-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# REDIS_URL=redis://localhost:6379
# KAFKA_BROKER_URL=localhost:9092

# --- JWT ---
# Must be identical across auth-service, event-service, and booking-service in every
# environment - they all verify tokens signed with this secret. Use a long random
# string in real environments, never the placeholder below.
JWT_SECRET=change-me-local-development-secret-change-me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- Google OAuth2 (leave blank until Phase 4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- reCAPTCHA (leave blank until wired up) ---
RECAPTCHA_SECRET=
