# Copy this file to .env (or export these into your shell / IDE run config).

# --- Server ---
SERVER_PORT=8084

# --- Database (local Docker Compose Postgres by default) ---
DATABASE_URL=jdbc:postgresql://localhost:15432/grabmyticket
DATABASE_USERNAME=grabmyticket
DATABASE_PASSWORD=grabmyticket

# --- Kafka (local Redpanda by default) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PAYMENT_EVENTS_TOPIC=payment-events

# --- Kafka (prod / Aiven) ---
# Same Aiven cluster/credentials as booking-service.
# KAFKA_BOOTSTRAP_SERVERS=<host>:<port>
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=<password>
# KAFKA_CA_CERT='-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----'

# --- Razorpay (leave blank until you paste your Test Mode keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- JWT ---
# MUST be byte-for-byte identical to auth-service's JWT_SECRET.
JWT_SECRET=change-me-local-development-secret-change-me

# --- Internal service-to-service secret ---
# MUST be byte-for-byte identical across all services.
INTERNAL_API_SECRET=change-me-local-development-internal-secret

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
