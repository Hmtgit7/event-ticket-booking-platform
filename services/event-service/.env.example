# Copy this file to .env.local (or export these into your shell / IDE run config).

# --- Server ---
SERVER_PORT=8082

# --- Database (local Docker Compose Postgres by default) ---
DATABASE_URL=jdbc:postgresql://localhost:15432/grabmyticket
DATABASE_USERNAME=grabmyticket
DATABASE_PASSWORD=grabmyticket

# --- Redis (local) ---
# Used by application-local.yaml (local/dev profile)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Redis (prod / Upstash) ---
# Used by application-prod.yaml. Set this on Render (or any prod host).
# Format: rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<upstash-host>:<port>
# Example: rediss://default:gQAAAB...@loyal-serval-85124.upstash.io:6380
# REDIS_URL=rediss://default:<token>@<host>:6380

# --- JWT ---
# MUST be byte-for-byte identical to auth-service's JWT_SECRET - this service only
# verifies tokens, it never issues them.
JWT_SECRET=change-me-local-development-secret-change-me

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
