# Copy this file to .env.local (or export these into your shell / IDE run config).

# --- Server ---
SERVER_PORT=8083

# --- Database (local Docker Compose Postgres by default) ---
DATABASE_URL=jdbc:postgresql://localhost:15432/grabmyticket
DATABASE_USERNAME=grabmyticket
DATABASE_PASSWORD=grabmyticket

# --- Redis (local) ---
# Used by application-local.yaml
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Redis (prod / Upstash) ---
# Used by application-prod.yaml. Get this from Upstash dashboard -> your
# database -> "Redis Connect" tab (NOT the REST API URL/token).
# Format: rediss://default:<password>@<host>:<port>
# REDIS_URL=rediss://default:<password>@<host>:6380

# --- Kafka (local Redpanda by default) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BOOKING_HOLD_TTL=5m
BOOKING_EVENTS_TOPIC=booking-events

# --- Kafka (prod / Aiven) ---
# application-prod.yaml uses SASL_SSL + SCRAM-SHA-256. Bootstrap servers is
# "<host>:<port>" with no protocol prefix. Aiven's cert is self-signed, so a
# truststore built from Aiven's CA certificate will also be needed - see
# Aiven dashboard -> Overview -> CA Certificate.
# KAFKA_BOOTSTRAP_SERVERS=<host>:<port>
# KAFKA_USERNAME=avnadminc
# KAFKA_PASSWORD=<password>

# --- Razorpay (leave blank until wired up) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- reCAPTCHA (leave blank until wired up) ---
RECAPTCHA_SECRET=

# --- JWT ---
# MUST be byte-for-byte identical to auth-service's JWT_SECRET - this service only
# verifies tokens, it never issues them.
JWT_SECRET=change-me-local-development-secret-change-me

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
