# Copy this file to .env.local (or export these into your shell / IDE run config).

# --- Server ---
SERVER_PORT=8083

# --- Database (local Docker Compose Postgres by default) ---
DATABASE_URL=jdbc:postgresql://localhost:15432/grabmyticket
DATABASE_USERNAME=grabmyticket
DATABASE_PASSWORD=grabmyticket

# --- Redis (local) ---
# Used by application-local.yaml
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Redis (prod / Upstash) ---
# Used by application-prod.yaml. Get this from Upstash dashboard -> your
# database -> "Redis Connect" tab (NOT the REST API URL/token).
# Format: rediss://default:<password>@<host>:<port>
# REDIS_URL=rediss://default:<password>@<host>:6380

# --- Kafka (local Redpanda by default) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BOOKING_HOLD_TTL=5m
BOOKING_EVENTS_TOPIC=booking-events
# Fraction of gross confirmed-booking revenue GrabMyTicket keeps (0.10 = 10%).
# Placeholder - confirm the real commission rate before go-live.
PLATFORM_COMMISSION_RATE=0.10
# Fraction of a cancelled booking's totalAmount withheld as a cancellation fee.
# Placeholder - confirm the real rate before go-live.
CANCELLATION_FEE_RATE=0.05
# Must match payment-service's PAYMENT_EVENTS_TOPIC exactly - this is what
# PaymentEventListener consumes to credit wallet recharges.
PAYMENT_EVENTS_TOPIC=payment-events

# --- Kafka (prod / Aiven) ---
# application-prod.yaml uses SASL_SSL + SCRAM-SHA-256. Bootstrap servers is
# "<host>:<port>" with no protocol prefix. Aiven's cert is self-signed, so a
# truststore built from Aiven's CA certificate will also be needed - see
# Aiven dashboard -> Overview -> CA Certificate.
# KAFKA_BOOTSTRAP_SERVERS=<host>:<port>
# KAFKA_USERNAME=avnadminc
# KAFKA_PASSWORD=<password>
# If you store Aiven's CA cert in .env, keep it on one line with literal \n.
# KAFKA_CA_CERT='-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----'

# --- Razorpay ---
# Moved to payment-service - booking-service no longer talks to Razorpay
# directly, it only consumes payment.completed events over Kafka.

# --- reCAPTCHA (leave blank until wired up) ---
RECAPTCHA_SECRET=

# --- JWT ---
# MUST be byte-for-byte identical to auth-service's JWT_SECRET - this service only
# verifies tokens, it never issues them.
JWT_SECRET=change-me-local-development-secret-change-me

# --- Internal service-to-service secret ---
# MUST be byte-for-byte identical to event-service's INTERNAL_API_SECRET - used to
# call its /internal/** endpoints (ticket-type snapshot + seat reserve/release).
INTERNAL_API_SECRET=change-me-local-development-internal-secret

# --- event-service base URL (for the internal snapshot/reserve/release calls) ---
EVENT_SERVICE_BASE_URL=http://localhost:8082

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional extra frontend origin(s), comma-separated (e.g. custom domain alongside Vercel).
CORS_ADDITIONAL_ORIGINS=
