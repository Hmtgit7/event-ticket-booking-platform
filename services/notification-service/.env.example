# Copy this file to .env for local development.
# Never commit real secrets.

# --- Server ---
PORT=3003
NODE_ENV=development

# --- Database (local) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/grabmyticket
# If running this service inside Docker while Postgres runs on your host,
# override localhost with host.docker.internal.
# DATABASE_URL=postgresql://postgres:password@host.docker.internal:5432/grabmyticket

# --- Database (Neon production) ---
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/grabmyticket?sslmode=require
# NODE_ENV=production

# --- JWT ---
# MUST be byte-for-byte identical to auth-service's JWT_SECRET - this service only
# verifies tokens, it never issues them.
JWT_SECRET=change-me-local-development-secret-change-me

# --- Kafka (local Redpanda by default) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BOOKING_EVENTS_TOPIC=booking-events
# Must match auth-service's AUTH_EVENTS_TOPIC exactly - carries
# user.account.deleted / user.persona.removed from Phase 9's account-deletion flow.
AUTH_EVENTS_TOPIC=auth-events
KAFKA_CONSUMER_GROUP_ID=notification-service
# --- Kafka (prod / Aiven) ---
# Aiven may show a single service URI like:
# kafka://<username>:<password>@<host>:<port>
# Do not paste that whole URI here. Split it into the three values below.
# KAFKA_BOOTSTRAP_SERVERS is only "<host>:<port>" with no kafka:// prefix.
# KAFKA_USERNAME=<aiven-username>
# KAFKA_PASSWORD=<aiven-password>
# KAFKA_SASL=true
# Preferred for production: paste Aiven's CA certificate here. Render accepts
# multiline env values, or you can replace newlines with literal \n.
# KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Local-only fallback for quick smoke tests if you have not pasted KAFKA_CA_CERT.
# KAFKA_SSL_REJECT_UNAUTHORIZED=false

# --- Brevo (transactional email) ---
# Leave BREVO_API_KEY unset locally to log emails to the console instead of sending them.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@grabmyticket.com
BREVO_SENDER_NAME=GrabMyTicket

# --- Client (for links inside emails, e.g. "View ticket") ---
FRONTEND_BASE_URL=http://localhost:3000
