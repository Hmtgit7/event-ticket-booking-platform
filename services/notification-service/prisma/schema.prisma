// Prisma schema for notification-service
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  /// Who this notification is FOR, not just whose account it's on - a dual-role
  /// account has one userId but should see isolated USER vs ORGANIZER inboxes.
  /// Extensible: ADMIN comes later as just another string value, no schema change.
  audience    String   @default("USER")
  type        String
  title       String
  message     String
  /// Id of the thing this notification is about (e.g. a bookingId) - lets the
  /// client deep-link "View ticket" straight from the notification.
  referenceId String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, audience, createdAt])
  @@map("notifications")
}
